# Copy this to .env and fill values
PORT=5000
NODE_ENV=development

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_KEY=your-service-role-key

# JWT
JWT_SECRET=replace-with-strong-secret
JWT_REFRESH_SECRET=replace-with-refresh-secret
JWT_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Encryption
AES_SECRET_KEY=32characterslongsecretkeyhere!!

# Gmail / SMTP (for dynamic OTP delivery to Gmail)
GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=your-gmail-app-password

# Twilio (optional for SMS OTP)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Frontend
FRONTEND_URL=http://localhost:8081

# Optional overrides
# SUPABASE_URL and keys can also be set as environment variables in your host
